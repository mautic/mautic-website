        {
         "id": "812b4ba",
         "elType": "widget",
         "widgetType": "text-editor",
         "settings": {
          "editor": "<p>Yes. Email <a href=\"mailto:membership@mautic.org\">membership@mautic.org</a> and we'll issue an invoice so you can pay in advance by bank transfer.</p>",
          "align": "left",
          "text_color": "#525252",
          "typography_typography": "custom",
