         "row": "8",
         "isLinked": "true"
        }
       },
       "elements": [
        {
         "id": "c9e1074",
         "elType": "widget",
         "widgetType": "text-editor",
         "settings": {
          "editor": "<p>Benefits of the same type are replaced rather than compounded. If Bronze includes 1 forum ad campaign and Silver includes 2, Silver members get 2 (not 3).</p>",
          "align": "left",
          "text_color": "#525252",
          "typography_typography": "custom",
          "typography_font_family": "Roboto",
          "typography_font_size": {
           "unit": "px",
           "size": 16,
