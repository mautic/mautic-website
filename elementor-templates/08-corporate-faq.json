        }
       },
       "elements": [
        {
         "id": "a97da62",
         "elType": "widget",
         "widgetType": "text-editor",
         "settings": {
          "editor": "<p>Individuals join for $100/year, pro-rated based on your country. You get a vote in the General Assembly, can stand in Council and leadership elections, and directly shape governance. Regular contributors may also qualify for the free participatory route.</p>",
          "align": "left",
          "text_color": "#525252",
          "typography_typography": "custom",
