         "elements": [],
         "isInner": false
        },
        {
         "id": "32d4538",
         "elType": "widget",
         "widgetType": "text-editor",
         "settings": {
          "editor": "<p>Regular contributions make that work easier to plan. A broader base of supporters also reduces reliance on a small number of organisations. For you, that means investing in the long-term maintenance of a tool you already depend on, rather than buying another software licence.</p>",
          "align": "left",
          "text_color": "#525252",
          "typography_typography": "custom",
