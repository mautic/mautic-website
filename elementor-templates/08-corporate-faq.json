         "isLinked": "true"
        }
       },
       "elements": [
        {
         "id": "ed3d2c2",
         "elType": "widget",
         "widgetType": "text-editor",
         "settings": {
          "editor": "<p>Pricing is tiered by country (loosely based on the Big Mac Index) so membership is affordable worldwide. To qualify for Tier 2 or Tier 3 pricing you'll need to provide evidence that your company's headquarters is in the selected country — for example company formation certificates supported by bank account information.</p>",
          "align": "left",
          "text_color": "#525252",
          "typography_typography": "custom",
          "typography_font_family": "Roboto",
          "typography_font_size": {
           "unit": "px",
           "size": 16,
           "sizes": []
          },
          "typography_line_height": {
           "unit": "em",
           "size": 1.6,
           "sizes": []
          }
         },
         "elements": [],
         "isInner": false
        }
       ],
       "isInner": true
      },
      {
       "id": "ec89566",
       "elType": "container",
       "settings": {
        "content_width": "full",
        "padding": {
         "unit": "px",
         "top": "4",
         "right": "4",
         "bottom": "18",
         "left": "4",
         "isLinked": "false"
        },
        "flex_gap": {
         "unit": "px",
         "size": 8,
         "column": "8",
         "row": "8",
         "isLinked": "true"
        }
       },
       "elements": [
        {
         "id": "38b3eff",
         "elType": "widget",
         "widgetType": "text-editor",
         "settings": {
          "editor": "<p>Some currencies can't be displayed due to Stripe limitations. If you don't see your country or expected currency, email <a href=\"mailto:membership@mautic.org\">membership@mautic.org</a> and we'll sort it out directly.</p>",
          "align": "left",
          "text_color": "#525252",
          "typography_typography": "custom",
          "typography_font_family": "Roboto",
          "typography_font_size": {
           "unit": "px",
           "size": 16,
           "sizes": []
          },
          "typography_line_height": {
           "unit": "em",
           "size": 1.6,
           "sizes": []
          }
         },
         "elements": [],
         "isInner": false
        }
       ],
       "isInner": true
      },
      {
       "id": "65b9eea",
       "elType": "container",
       "settings": {
        "content_width": "full",
        "padding": {
         "unit": "px",
         "top": "4",
         "right": "4",
         "bottom": "18",
         "left": "4",
         "isLinked": "false"
        },
        "flex_gap": {
         "unit": "px",
         "size": 8,
