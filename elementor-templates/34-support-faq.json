     "settings": {
      "items": [
       {
        "item_title": "Do I have to pay to keep using Mautic?",
        "_id": "f2b0f97",
        "element_css_id": ""
       },
       {
        "item_title": "I already pay for Mautic hosting or services. Doesn't that fund the project?",
        "_id": "bd566be",
        "element_css_id": ""
       },
       {
        "item_title": "What is the difference between a donation and membership?",
        "_id": "c5ead2a",
        "element_css_id": ""
       },
       {
        "item_title": "Does supporting Mautic buy technical support or a particular feature?",
        "_id": "4bad0b4",
        "element_css_id": ""
       },
       {
        "item_title": "Can my company request an invoice?",
        "_id": "65e713d",
        "element_css_id": ""
       },
       {
        "item_title": "Can I contribute without money?",
        "_id": "ac078a8",
        "element_css_id": ""
       }
      ],
      "default_state": "all_collapsed",
