        {
         "id": "44c8598",
         "elType": "widget",
         "widgetType": "text-editor",
         "settings": {
          "editor": "<p>Volunteers contribute code, testing, documentation and advice. But a project also needs funded time to coordinate that work, maintain shared infrastructure and plan what comes next.</p>",
          "align": "left",
          "text_color": "#525252",
          "typography_typography": "custom",
